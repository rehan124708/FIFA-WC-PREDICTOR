// ==========================================
// 3. MAIN COMPONENT EXPORT (VSC SUITE)
// ==========================================
export default function WC2026PredictorApp() {
  const [state, setState] = useState<PredictionState>(INITIAL_STATE);

  useEffect(() => {
    const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
    if (saved) {
      try { setState(JSON.parse(saved)); } catch (e) { console.error(e); }
    }
  }, []);

  const saveState = (newState: PredictionState) => {
    setState(newState);
    localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(newState));
  };

  const handleReset = () => {
    if (window.confirm('Reset all predictions?')) {
      saveState(INITIAL_STATE);
    }
  };

  const currentStagePercent = () => {
    switch (state.currentStage) {
      case 'LOBBY': return 0;
      case 'GROUPS': return 15;
      case 'THIRD_PLACE': return 30;
      case 'R32': return 50;
      case 'R16': return 65;
      case 'QF': return 80;
      case 'SF': return 90;
      case 'FINAL': return 95;
      case 'COMPLETE': return 100;
      default: return 0;
    }
  };

  const getThirdPlacedTeams = () => {
    const ids = ['A','B','C','D','E','F','G','H','I','J','K','L'];
    return ids.map(id => {
      const gStand = state.groupStandings[id] || [];
      const team = gStand[2] || INITIAL_GROUPS.find(g => g.id === id)!.teams[2];
      return { groupId: id, team };
    });
  };

  const handleMoveUp = (groupId: string, index: number) => {
    if (index === 0) return;
    const currentTeams = [...state.groupStandings[groupId]];
    const temp = currentTeams[index];
    currentTeams[index] = currentTeams[index - 1];
    currentTeams[index - 1] = temp;
    saveState({
      ...state,
      groupStandings: { ...state.groupStandings, [groupId]: currentTeams }
    });
  };

  const handleMoveDown = (groupId: string, index: number) => {
    const currentTeams = state.groupStandings[groupId];
    if (index === currentTeams.length - 1) return;
    const nextTeams = [...currentTeams];
    const temp = nextTeams[index];
    nextTeams[index] = nextTeams[index + 1];
    nextTeams[index + 1] = temp;
    saveState({
      ...state,
      groupStandings: { ...state.groupStandings, [groupId]: nextTeams }
    });
  };

  const handleAutoSimulateGroups = () => {
    const simulated: Record<string, Team[]> = {};
    INITIAL_GROUPS.forEach(g => {
      const teams = [...g.teams];
      for (let i = 0; i < teams.length - 1; i++) {
        if (Math.random() > 0.6) {
          const temp = teams[i];
          teams[i] = teams[i + 1];
          teams[i + 1] = temp;
        }
      }
      simulated[g.id] = teams;
    });
    saveState({ ...state, groupStandings: simulated });
  };

  const handleToggleThirdPlace = (teamId: string) => {
    const current = [...state.selectedThirdPlaceIds];
    const index = current.indexOf(teamId);
    if (index >= 0) {
      current.splice(index, 1);
    } else {
      if (current.length >= 8) {
        alert('8 wildcard spots are already selected!');
        return;
      }
      current.push(teamId);
    }
    saveState({ ...state, selectedThirdPlaceIds: current });
  };

  const handleProceedR32 = () => {
    const standings = state.groupStandings;
    const w = (gid: string) => standings[gid]?.[0] || INITIAL_GROUPS.find(g => g.id === gid)!.teams[0];
    const r = (gid: string) => standings[gid]?.[1] || INITIAL_GROUPS.find(g => g.id === gid)!.teams[1];
    
    const selectedWildcards: Team[] = [];
    const thirdPlaced = getThirdPlacedTeams();
    thirdPlaced.forEach(({ team }) => {
      if (state.selectedThirdPlaceIds.includes(team.id)) {
        selectedWildcards.push(team);
      }
    });

    while (selectedWildcards.length < 8) {
      const candidate = thirdPlaced.find(item => !selectedWildcards.includes(item.team));
      if (!candidate) break;
      selectedWildcards.push(candidate.team);
    }

    const matches: Match[] = [
      { id: 'R32-M1', stage: 'R32', home: w('A'), away: selectedWildcards[0] || null },
      { id: 'R32-M2', stage: 'R32', home: w('B'), away: r('C') },
      { id: 'R32-M3', stage: 'R32', home: w('D'), away: selectedWildcards[1] || null },
      { id: 'R32-M4', stage: 'R32', home: r('A'), away: r('B') },
      { id: 'R32-M5', stage: 'R32', home: w('E'), away: selectedWildcards[2] || null },
      { id: 'R32-M6', stage: 'R32', home: w('F'), away: r('D') },
      { id: 'R32-M7', stage: 'R32', home: w('G'), away: selectedWildcards[3] || null },
      { id: 'R32-M8', stage: 'R32', home: r('E'), away: r('F') },
      { id: 'R32-M9', stage: 'R32', home: w('H'), away: selectedWildcards[4] || null },
      { id: 'R32-M10', stage: 'R32', home: w('I'), away: r('J') },
      { id: 'R32-M11', stage: 'R32', home: w('J'), away: selectedWildcards[5] || null },
      { id: 'R32-M12', stage: 'R32', home: r('G'), away: r('H') },
      { id: 'R32-M13', stage: 'R32', home: w('K'), away: selectedWildcards[6] || null },
      { id: 'R32-M14', stage: 'R32', home: w('L'), away: r('I') },
      { id: 'R32-M15', stage: 'R32', home: r('K'), away: r('L') },
      { id: 'R32-M16', stage: 'R32', home: w('C'), away: selectedWildcards[7] || null },
    ];

    saveState({
      ...state,
      r32Matches: matches,
      currentStage: 'R32',
    });
  };

  const handlePredictWinner = (matchId: string, winnerId: string, homeScore: number, awayScore: number) => {
    let key: 'r32Matches' | 'r16Matches' | 'qfMatches' | 'sfMatches' | 'finalMatch' = 'r32Matches';
    if (matchId.startsWith('R32')) key = 'r32Matches';
    else if (matchId.startsWith('R16')) key = 'r16Matches';
    else if (matchId.startsWith('QF')) key = 'qfMatches';
    else if (matchId.startsWith('SF')) key = 'sfMatches';
    else if (matchId.startsWith('FINAL')) key = 'finalMatch';

    if (key === 'finalMatch') {
      const match = state.finalMatch;
      if (!match) return;
      saveState({ ...state, finalMatch: { ...match, winnerId, homeScore, awayScore } });
      return;
    }

    const updated = state[key].map(m => m.id === matchId ? { ...m, winnerId, homeScore, awayScore } : m);
    saveState({ ...state, [key]: updated } as any);
  };

  const handleAutoSimulateStage = () => {
    let key: 'r32Matches' | 'r16Matches' | 'qfMatches' | 'sfMatches' | 'finalMatch' = 'r32Matches';
    if (state.currentStage === 'R32') key = 'r32Matches';
    else if (state.currentStage === 'R16') key = 'r16Matches';
    else if (state.currentStage === 'QF') key = 'qfMatches';
    else if (state.currentStage === 'SF') key = 'sfMatches';
    else if (state.currentStage === 'FINAL') key = 'finalMatch';

    if (key === 'finalMatch') {
      const m = state.finalMatch;
      if (!m || !m.home || !m.away) return;
      const h = Math.floor(Math.random() * 3) + 1;
      let a = Math.floor(Math.random() * 3);
      if (h === a) a++;
      saveState({ ...state, finalMatch: { ...m, winnerId: h > a ? m.home.id : m.away.id, homeScore: h, awayScore: a } });
      return;
    }

    const updated = state[key].map(m => {
      if (!m.home || !m.away) return m;
      const h = Math.floor(Math.random() * 4);
      let a = Math.floor(Math.random() * 4);
      if (h === a) a++;
      return { ...m, winnerId: h > a ? m.home.id : m.away.id, homeScore: h, awayScore: a };
    });
    saveState({ ...state, [key]: updated } as any);
  };

  const handleProceedR16 = () => {
    const winners = state.r32Matches.map(m => m.winnerId === m.home?.id ? m.home : m.away);
    const r16: Match[] = Array.from({ length: 8 }, (_, i) => ({
      id: `R16-M${i + 1}`,
      stage: 'R16',
      home: winners[i * 2] || null,
      away: winners[i * 2 + 1] || null,
    }));
    saveState({ ...state, r16Matches: r16, currentStage: 'R16' });
  };

  const handleProceedQF = () => {
    const winners = state.r16Matches.map(m => m.winnerId === m.home?.id ? m.home : m.away);
    const qf: Match[] = Array.from({ length: 4 }, (_, i) => ({
      id: `QF-M${i + 1}`,
      stage: 'QF',
      home: winners[i * 2] || null,
      away: winners[i * 2 + 1] || null,
    }));
    saveState({ ...state, qfMatches: qf, currentStage: 'QF' });
  };

  const handleProceedSF = () => {
    const winners = state.qfMatches.map(m => m.winnerId === m.home?.id ? m.home : m.away);
    const sf: Match[] = Array.from({ length: 2 }, (_, i) => ({
      id: `SF-M${i + 1}`,
      stage: 'SF',
      home: winners[i * 2] || null,
      away: winners[i * 2 + 1] || null,
    }));
    saveState({ ...state, sfMatches: sf, currentStage: 'SF' });
  };

  const handleProceedFinal = () => {
    const winners = state.sfMatches.map(m => m.winnerId === m.home?.id ? m.home : m.away);
    saveState({
      ...state,
      finalMatch: { id: 'FINAL-M1', stage: 'FINAL', home: winners[0] || null, away: winners[1] || null },
      currentStage: 'FINAL',
    });
  };

  const handleCrownChampion = () => {
    if (!state.finalMatch || !state.finalMatch.winnerId) return;
    saveState({ ...state, championId: state.finalMatch.winnerId, currentStage: 'COMPLETE' });
  };

  const handleBack = () => {
    const s = state.currentStage;
    if (s === 'GROUPS') saveState({ ...state, currentStage: 'LOBBY' });
    else if (s === 'THIRD_PLACE') saveState({ ...state, currentStage: 'GROUPS' });
    else if (s === 'R32') saveState({ ...state, currentStage: 'THIRD_PLACE' });
    else if (s === 'R16') saveState({ ...state, currentStage: 'R32' });
    else if (s === 'QF') saveState({ ...state, currentStage: 'R16' });
    else if (s === 'SF') saveState({ ...state, currentStage: 'QF' });
    else if (s === 'FINAL') saveState({ ...state, currentStage: 'SF' });
    else if (s === 'COMPLETE') saveState({ ...state, currentStage: 'FINAL' });
  };

  // Helper formatting helper
  const isSelectedWildcard = (id: string) => state.selectedThirdPlaceIds.includes(id);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-emerald-500/30">
      
      {/* 🚀 Header */}
      <header className="sticky top-0 z-50 bg-slate-900/90 backdrop-blur border-b border-slate-800 text-white py-4 px-6 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="p-2 bg-gradient-to-tr from-amber-500 to-yellow-400 rounded-lg text-slate-950">
            <Trophy className="w-5 h-5 animate-pulse" />
          </div>
          <div>
            <h1 className="text-xl font-black bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-400 bg-clip-text text-transparent">
              FIFA WORLD CUP 2026 PREDICTOR
            </h1>
            <p className="text-[10px] text-slate-400 font-mono">VIBRANT ONE-FILE VSC SUITE</p>
          </div>
        </div>
        <div className="flex items-center gap-4">
          <div className="hidden sm:block text-right">
            <p className="text-xs font-bold text-slate-200">Stage Percent</p>
            <span className="text-xs text-teal-400 font-mono font-bold">{currentStagePercent()}% Done</span>
          </div>
          {state.currentStage !== 'LOBBY' && (
            <button
              onClick={handleReset}
              className="flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-rose-950/30 border border-slate-700 hover:border-rose-900 rounded-md text-xs text-slate-300 hover:text-rose-400 transition-all cursor-pointer"
            >
              <RefreshCw className="w-3 h-3" />
              <span>Reset</span>
            </button>
          )}
        </div>
      </header>

      {/* 🔮 Stage Renderers */}
      <main className="flex-grow max-w-6xl mx-auto w-full px-4 py-8">
        
        {/* ==================== LOBBY ==================== */}
        {state.currentStage === 'LOBBY' && (
          <div className="text-center py-16 relative">
            <h2 className="text-5xl sm:text-7xl font-black tracking-tight leading-none mb-6">
              PREDICT THE <br />
              <span className="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 via-amber-300 to-rose-400">
                2026 CHAMPION
              </span>
            </h2>
            <p className="text-slate-300 text-base max-w-xl mx-auto mb-10 leading-relaxed">
              Expands directly into a vibrant tournament simulator. Rearrange groups A-L based on the actual 48-nation teams, choose the wildcard 3rd places, and select every winner lists.
            </p>
            <button
              onClick={() => saveState({ ...state, currentStage: 'GROUPS' })}
              className="px-8 py-4 bg-gradient-to-r from-emerald-400 via-teal-400 to-amber-300 text-slate-950 font-black rounded-xl text-lg tracking-wide hover:scale-105 active:scale-95 transition-all flex items-center gap-3.5 mx-auto cursor-pointer"
            >
              <Play className="w-5 h-5 fill-slate-950" />
              ENTER PREDICTOR LEVEL
            </button>
          </div>
        )}

        {/* ==================== GROUP PREDICTOR ==================== */}
        {state.currentStage === 'GROUPS' && (
          <div>
            <div className="flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-900/60 border border-slate-850 p-5 rounded-2xl mb-8">
              <div>
                <h3 className="text-lg font-bold">Level 1: Arrange Group Standings</h3>
                <p className="text-xs text-slate-400">Position 1 & 2 advance to matches. Position 3 enters the Wildcard Pool.</p>
              </div>
              <div className="flex items-center gap-3">
                <button onClick={handleAutoSimulateGroups} className="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-xs rounded-lg font-bold border border-slate-700 cursor-pointer">
                  🎲 Simulator All
                </button>
                <button onClick={() => saveState({ ...state, selectedThirdPlaceIds: getThirdPlacedTeams().slice(0, 8).map(x => x.team.id), currentStage: 'THIRD_PLACE' })} className="px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-xs rounded-lg cursor-pointer flex items-center gap-1">
                  <span>Wildcard Stage</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {INITIAL_GROUPS.map(group => {
                const teams = state.groupStandings[group.id] || group.teams;
                return (
                  <div key={group.id} className="bg-slate-900/40 border border-slate-800 rounded-xl overflow-hidden p-4">
                    <span className="text-sm font-black text-teal-400 mb-3 block">{group.name}</span>
                    <div className="space-y-2">
                      {teams.map((team, idx) => (
                        <div 
                          key={team.id} 
                          className="flex items-center justify-between p-2 rounded-lg border border-slate-800/80"
                          style={{ backgroundColor: `${team.primaryColor}12` }}
                        >
                          <div className="flex items-center gap-2">
                            <span className="text-xl select-none">{team.flag}</span>
                            <span className="text-xs font-bold">{team.name}</span>
                          </div>
                          <div className="flex items-center gap-1">
                            <button disabled={idx===0} onClick={()=>handleMoveUp(group.id, idx)} className="p-1 rounded bg-slate-800 disabled:opacity-20 text-slate-400 hover:text-white cursor-pointer"><ChevronUp className="w-3 h-3" /></button>
                            <button disabled={idx===3} onClick={()=>handleMoveDown(group.id, idx)} className="p-1 rounded bg-slate-800 disabled:opacity-20 text-slate-400 hover:text-white cursor-pointer"><ChevronDown className="w-3 h-3" /></button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ==================== WILDCARDS ==================== */}
        {state.currentStage === 'THIRD_PLACE' && (
          <div>
            <div className="flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-900/60 border border-slate-850 p-5 rounded-2xl mb-8">
              <div>
                <h3 className="text-lg font-bold">Level 2: Select 8 Wildcards ({state.selectedThirdPlaceIds.length}/8)</h3>
                <p className="text-xs text-slate-400">Pick the 8 third-placed direct qualifiers that survive to complete the RO32 bracket.</p>
              </div>
              <button disabled={state.selectedThirdPlaceIds.length !== 8} onClick={handleProceedR32} className="px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black text-sm rounded-lg disabled:opacity-40 cursor-pointer">
                Unlock Knockouts ➔
              </button>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
              {getThirdPlacedTeams().map(({ groupId, team }) => {
                const checked = isSelectedWildcard(team.id);
                return (
                  <div
                    key={team.id}
                    onClick={() => handleToggleThirdPlace(team.id)}
                    className={`p-4 rounded-xl border cursor-pointer transition-all ${checked ? 'border-emerald-500 hover:opacity-100' : 'border-slate-800 opacity-60 hover:opacity-100'}`}
                    style={{ backgroundColor: checked ? `${team.primaryColor}25` : undefined }}
                  >
                    <span className="text-[10px] uppercase font-mono block text-slate-400">Group {groupId} (3rd)</span>
                    <span className="text-2xl my-2 block">{team.flag}</span>
                    <h4 className="font-bold text-sm truncate">{team.name}</h4>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ==================== BRACKET PREDICTORS ==================== */}
        {['R32', 'R16', 'QF', 'SF', 'FINAL'].includes(state.currentStage) && (
          <div>
            {(() => {
              let matches: Match[] = [];
              if (state.currentStage === 'R32') matches = state.r32Matches;
              else if (state.currentStage === 'R16') matches = state.r16Matches;
              else if (state.currentStage === 'QF') matches = state.qfMatches;
              else if (state.currentStage === 'SF') matches = state.sfMatches;
              else if (state.currentStage === 'FINAL') matches = state.finalMatch ? [state.finalMatch] : [];

              const complete = matches.every(m => m.winnerId && m.home && m.away);

              const handleProceedNext = () => {
                if (state.currentStage === 'R32') handleProceedR16();
                else if (state.currentStage === 'R16') handleProceedQF();
                else if (state.currentStage === 'QF') handleProceedSF();
                else if (state.currentStage === 'SF') handleProceedFinal();
                else if (state.currentStage === 'FINAL') handleCrownChampion();
              };

              return (
                <div>
                  <div className="flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-900/60 border border-slate-850 p-5 rounded-2xl mb-8">
                    <div>
                      <h3 className="text-lg font-bold">Predicting Stage: {state.currentStage}</h3>
                      <p className="text-xs text-slate-400">Click a country card's checkmark to select the winner, or type scores manually.</p>
                    </div>
                    <div className="flex items-center gap-3">
                      <button onClick={handleAutoSimulateStage} className="px-3.5 py-2 bg-slate-800 text-xs border border-slate-700/80 hover:bg-slate-700 rounded-lg cursor-pointer">
                        🎲 Simulate Stage Matches
                      </button>
                      <button disabled={!complete} onClick={handleProceedNext} className="px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs rounded-lg cursor-pointer">
                        {state.currentStage === 'FINAL' ? '🏆 Crown Champion' : 'Next Stage ➔'}
                      </button>
                    </div>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {matches.map((match, idx) => {
                      const hSelected = match.winnerId === match.home?.id;
                      const aSelected = match.winnerId === match.away?.id;
                      return (
                        <div key={match.id} className="bg-slate-900/50 border border-slate-800 rounded-xl p-4">
                          <span className="text-[10px] font-mono text-slate-500 uppercase block mb-3">Match {idx+1} ({match.id})</span>
                          <div className="space-y-3">
                            
                            {/* Home */}
                            {match.home ? (
                              <div onClick={() => handlePredictWinner(match.id, match.home!.id, 2, 1)} className={`flex items-center justify-between p-3 rounded-xl cursor-pointer border ${hSelected ? 'border-emerald-500' : 'border-slate-800'}`} style={{ backgroundColor: hSelected ? `${match.home.primaryColor}22` : undefined }}>
                                <div className="flex items-center gap-3">
                                  <span className="text-2xl">{match.home.flag}</span>
                                  <span className="text-sm font-bold">{match.home.name}</span>
                                </div>
                                <div className="flex items-center gap-2">
                                  <span className={`w-5 h-5 rounded-full flex items-center justify-center border text-xs ${hSelected ? 'bg-emerald-500 text-slate-950' : 'border-slate-700'}`}>{hSelected && '✓'}</span>
                                </div>
                              </div>
                            ) : <span className="text-xs text-slate-500 block py-2 border-dashed border rounded p-4 text-center">Empty Spot</span>}

                            <div className="text-center text-[10px] text-slate-650 font-bold uppercase font-mono tracking-widest">VS</div>

                            {/* Away */}
                            {match.away ? (
                              <div onClick={() => handlePredictWinner(match.id, match.away!.id, 1, 2)} className={`flex items-center justify-between p-3 rounded-xl cursor-pointer border ${aSelected ? 'border-emerald-500' : 'border-slate-800'}`} style={{ backgroundColor: aSelected ? `${match.away.primaryColor}22` : undefined }}>
                                <div className="flex items-center gap-3">
                                  <span className="text-2xl">{match.away.flag}</span>
                                  <span className="text-sm font-bold">{match.away.name}</span>
                                </div>
                                <div className="flex items-center gap-2">
                                  <span className={`w-5 h-5 rounded-full flex items-center justify-center border text-xs ${aSelected ? 'bg-emerald-500 text-slate-950' : 'border-slate-700'}`}>{aSelected && '✓'}</span>
                                </div>
                              </div>
                            ) : <span className="text-xs text-slate-500 block py-2 border-dashed border rounded p-4 text-center">Empty Spot</span>}

                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })()}
          </div>
        )}

        {/* ==================== CELEBRATION ==================== */}
        {state.currentStage === 'COMPLETE' && state.championId && (
          <div className="text-center py-10">
            <span className="text-6xl sm:text-8xl select-none animate-bounce block mb-4">
              {TEAMS[state.championId]?.flag}
            </span>
            <h2 className="text-3xl sm:text-5xl font-black uppercase text-gradient bg-clip-text bg-gradient-to-r from-amber-400 to-yellow-200">
              {TEAMS[state.championId]?.name} ARE CHAMPIONS!
            </h2>
            <p className="text-slate-400 mt-2">Predicted successfully through all levels.</p>

            <button
              onClick={() => saveState(INITIAL_STATE)}
              className="mt-8 px-6 py-3 bg-gradient-to-r from-emerald-500 to-teal-500 text-slate-950 font-black rounded-lg text-sm tracking-wide hover:scale-103 cursor-pointer inline-flex items-center gap-1.5"
            >
              <RefreshCw className="w-4 h-4" />
              <span>PREDICT DIFFERENT PATHWAY</span>
            </button>
          </div>
        )}

      </main>

      {/* 🌟 Professional Application Developer Credits 🌟 */}
      <footer className="py-12 border-t border-slate-900 bg-slate-950/70 text-center text-slate-500 text-xs mt-16 leading-relaxed">
        <div className="inline-flex py-1.5 px-3 bg-slate-900/60 border border-slate-800 rounded-lg text-slate-400 mb-4 items-center">
          <Heart className="w-3.5 h-3.5 text-rose-500 mr-2.5 fill-rose-500" />
          <span>Made for football fans anticipating 2026</span>
        </div>
        <p className="font-mono">
          Applet: <strong className="text-slate-300">FIFA World Cup 2026 App Suite</strong>
          <br />
          Built with: <strong className="text-emerald-400">React + Framer-Motion + Lucide + Tailwind</strong>
          <br />
          Host Container: <strong className="text-slate-400">Google AI Studio Build (Cloud Run Sandbox)</strong>
        </p>
      </footer>

    </div>
  );
}

