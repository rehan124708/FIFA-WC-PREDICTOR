// ==========================================
// 1. TYPES & CONTRACTS
// ==========================================
export interface Team {
  id: string;
  name: string;
  code: string;
  flag: string;
  primaryColor: string;
  secondaryColor: string;
  textColor: string;
  confederation: string;
}

export interface Group {
  id: string;
  name: string;
  teams: Team[];
}

export type BracketStageId = 'LOBBY' | 'GROUPS' | 'THIRD_PLACE' | 'R32' | 'R16' | 'QF' | 'SF' | 'FINAL' | 'COMPLETE';

export interface Match {
  id: string;
  stage: BracketStageId;
  home: Team | null;
  away: Team | null;
  homeScore?: number;
  awayScore?: number;
  winnerId?: string;
}

export interface PredictionState {
  currentStage: BracketStageId;
  groupStandings: Record<string, Team[]>;
  selectedThirdPlaceIds: string[];
  r32Matches: Match[];
  r16Matches: Match[];
  qfMatches: Match[];
  sfMatches: Match[];
  finalMatch: Match | null;
  championId: string | null;
}

